{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git rm:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(./.venv/Scripts/python.exe:*)",
      "PowerShell(git status:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(.\\.venv\\Scripts\\python.exe:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(New-Item:*)",
      "PowerShell(Copy-Item:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git remote:*)",
      "PowerShell(git remote:*)"
    ]
  }
}
